# Copy this file to .env and fill in your own values. Never commit .env.

# Postgres connection string (Neon: Connection Details -> copy the connection string).
# Keep it secret: it contains the database password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Port the server listens on locally (Render sets its own).
PORT=3000

# Websites allowed to call this API from a browser.
# Comma-separated, no spaces, no trailing slash. Example with local + deployed front end:
#   CORS_ORIGIN=http://localhost:5173,https://your-frontend.example.com
# "*" allows any website. Use it for quick demos only.
CORS_ORIGIN=http://localhost:5173

# Set to "production" on Render. It makes the sid cookie Secure, and SameSite=None
# when CORS_ORIGIN is set, which a front end on another site needs.
NODE_ENV=development
